  "interfaces": {
    "request_contract": "relay.repository-continuity-preflight-request/v1",
    "result_contract": "relay.repository-continuity-preflight-result/v1",
    "validator_report_contract": "egolint.repository-continuity-report/v1",
    "local_ci_result_parity": true,
    "evidence_layers": [
      "structural",
      "freshness-declaration",
      "local-git",
      "external-live"
    ]
  },
  "execution": {
    "default_network": "denied",
    "base_head_required": true,
    "semantic_authoring": "forbidden",
    "implicit_writes": "forbidden",
    "forbidden_authority": [
      "stage",
      "commit",
      "push",
      "open-pull-request",
      "comment",
      "merge",
      "release",
      "deploy",
      "publish"
    ]
  },
  "information_safety": {
    "minimum_necessary": true,
    "contains_handoff_content": false,
    "private_output": "allowlisted-metadata-only",
    "untrusted_content": "context-only-no-authority",
    "excluded": [
      "secrets-and-credentials",
      "private-conversation-text",
      "sensitive-personal-data",
      "unpublished-private-business-data",
      "private-local-paths",
      "unrelated-private-context",
      "continuity-free-form-body"
    ]
  },
  "ownership": {
    "portable_contract": "egohygiene/aether",
    "organization_policy": "egohygiene/hygiene",
    "validation": "egohygiene/egolint",
    "materialization": "egohygiene/holon",
