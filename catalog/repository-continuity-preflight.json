  "status": "proposed",
  "owner": "egohygiene/relay",
  "updated": "2026-09-09",
  "purpose": "Bind Relay's future local and pull-request continuity preflights to one immutable, privacy-safe evidence contract without authoring semantic handoff prose.",
  "rollout": {
    "stage": "observe",
    "maximum_stage_before_release": "observe",
    "activation_gate": [
      "Aether marks the pinned repository-continuity contract and skill stable and release-included",
      "Hygiene accepts and releases the pinned organization policy",
      "EgoLint releases the pinned continuity validator and report contract",
      "Holon promotes the pinned continuity materialization profile",
      "A maintainer explicitly promotes this Relay profile after local and CI parity evidence is reviewed"
    ],
    "unavailable_behavior": "fail-closed-with-explicit-unavailable-result"
  },
