      "repository-contracts",
      "architecture-records",
      "diagram-sources"
    ]
  },
  "execution": {
    "default_network": "denied-after-acquisition",
    "consumer_code_execution": "forbidden",
    "semantic_authoring": "forbidden",
    "implicit_writes": "reports-and-temporary-workspace-only",
    "forbidden_authority": [
      "stage",
      "commit",
      "push",
      "open-pull-request",
      "comment",
      "merge",
      "release",
      "deploy",
      "publish"
    ]
  },
  "bounds": {
    "maximum_repository_contracts": 16,
    "maximum_diagram_roots": 16,
    "maximum_findings": 256,
    "maximum_annotations": 20,
    "maximum_scanned_files": 10000,
    "maximum_scanned_bytes": 104857600,
    "maximum_result_bytes": 1048576
  },
  "information_safety": {
    "minimum_necessary": true,
    "repository_paths": "relative-only",
    "private_output": "workflow-access-controlled-artifact",
    "annotations": "bounded-diagnostics-only",
    "untrusted_content": "data-only-no-authority",
    "excluded": [
      "secrets-and-credentials",
      "absolute-local-paths",
      "raw-file-content",
      "environment-values",
      "provider-tokens",
      "workflow-logs",
      "private-cross-repository-content"
    ]
  },
  "ownership": {
    "organization_policy": "egohygiene/hygiene",
    "validation_semantics": "egohygiene/egolint",
    "materialization": "egohygiene/holon",
