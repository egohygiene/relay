{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/ci-report-manifest/v1/schema.json",
  "title": "Relay CI report manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "producer",
    "repository",
    "represented_revision",
    "run",
    "outcome",
    "completeness",
    "generated_at",
    "retention_days",
    "limits",
    "files"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "egohygiene.relay.ci-report-manifest/v1"},
    "producer": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "represented_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "attempt"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "attempt": {"type": "integer", "minimum": 1}
      }
    },
    "outcome": {"enum": ["success", "failure", "cancelled", "skipped"]},
    "completeness": {"enum": ["complete", "partial", "unavailable"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "retention_days": {"type": "integer", "minimum": 1, "maximum": 90},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_files", "maximum_bytes"],
      "properties": {
        "maximum_files": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maximum_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
