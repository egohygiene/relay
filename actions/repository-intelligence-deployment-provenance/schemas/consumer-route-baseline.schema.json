{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/repository-intelligence-consumer-route-baseline/v1/schema.json",
  "title": "Repository Intelligence consumer route baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "consumer", "managed_route_prefix", "files", "routes"],
  "properties": {
    "schema": {"const": "egohygiene.relay.repository-intelligence-consumer-route-baseline/v1"},
    "schema_version": {"const": 1},
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "managed_route_prefix": {"const": "/intelligence/"},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/file"}
    },
    "routes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/route"}
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "entrypoint", "sha256"],
      "properties": {
        "route": {"type": "string", "pattern": "^/(?:[A-Za-z0-9._-]+/)*$"},
        "entrypoint": {"type": "string", "pattern": "^(?:[A-Za-z0-9._-]+/)*index\\.html$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
