  "composition": {
    "agent_ready_web": "Site class is shared; this registry identifies product routes while Agent-Ready Web owns discovery, representation, capability, commerce, and conformance policy.",
    "public_site_policy": "The proposed contract tracked by https://github.com/egohygiene/hygiene/issues/17 owns legal, policy, trust, disclosure, review, and jurisdiction semantics; this registry owns only the corresponding route identities and declaration state.",
    "repository_intelligence": "Intelligence-backed routes consume versioned projections and never replace canonical roadmap, ADR, Git, GitHub, release, deployment, or provider sources.",
    "repository_presentation": "The presentation profile owns README and orientation semantics; this registry owns routable public-site surface identity and declaration state.",
    "identity": "Identity owns the /identity/ product experience and released assets. The distinct Identity Intelligence adoption module uses /intelligence/identity/ until the organization route conflict is explicitly reconciled; neither owns site publication.",
    "renderflow": "Renderflow may produce magazine and presentation artifacts; consuming sites retain route composition and publication authority.",
    "status": "The status surface reserves route identity only; the separately reviewed System Status contract owns incident and operational semantics."
  },
  "ownership": {
    "hygiene": "Own the registry, declaration schema, route identity, state semantics, compatibility, and privacy boundary.",
    "subject_repository": "Own truthful facts, applicability decisions, represented revision, source artifacts, and the semantics of surfaces whose registry owner is repository.",
    "publication_repository": "Own publication configuration, final route composition, and deploy authority without taking ownership of subject facts or globally named surface semantics.",
    "identity": "Publish versioned brand and identity assets without taking ownership of site facts or routes.",
    "holon": "Scaffold new repositories from an eligible immutable pin without inventing declarations or evidence.",
    "relay": "Provide reusable validation, rendering, and publication workflows without redefining registry semantics or publishing without repository authority.",
    "observatory": "Normalize privacy-safe declarations and freshness evidence without silent remediation or private-topology disclosure.",
    "pace": "Propose reviewed existing-repository adoption and reconciliation without direct default-branch mutation.",
    "egohygiene_io": "Compose and host the organization site while consuming canonical contracts and organization-owned facts."
  }
