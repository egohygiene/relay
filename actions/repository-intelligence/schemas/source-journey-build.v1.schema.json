{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/source-journey-build.v1.schema.json",
  "title": "Fresh immutable Git Journey source receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "observed_at",
    "status",
    "inputs",
    "scope",
    "runtime",
    "validation",
    "coverage",
    "candidate_digests",
    "schema",
    "admission",
    "source_commit",
    "commit_revisions"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "ready",
        "partial"
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collected_at",
        "maximum_age_seconds",
        "maximum_commits",
        "since",
        "until",
        "public_subjects",
        "commits"
      ],
      "properties": {
        "collected_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "maximum_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2678400
        },
        "maximum_commits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "since": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "pattern": "Z$"
        },
        "public_subjects": {
          "const": false
        },
        "commits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "revision",
              "sha256"
            ],
            "properties": {
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shallow",
        "truncated",
        "time_filtered",
        "withheld_timestamps",
        "provider_events",
        "parent_topology",
        "declared_reference_resolution"
      ],
      "properties": {
        "shallow": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "time_filtered": {
          "type": "boolean"
        },
        "withheld_timestamps": {
          "type": "boolean"
        },
        "provider_events": {
          "const": "uncollected"
        },
        "parent_topology": {
          "const": "unavailable"
        },
        "declared_reference_resolution": {
          "const": "unavailable"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_sha256",
        "egolint_sha256",
        "collector_sha256",
        "shared_runtime_sha256",
        "pins",
        "normalizer_adapter_sha256"
      ],
      "properties": {
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "egolint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "collector_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "shared_runtime_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "pins": {
          "type": "object"
        },
        "normalizer_adapter_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "egolint",
        "hygiene",
        "coverage",
        "observatory",
        "diagnostics_truncated"
      ],
      "properties": {
        "egolint": {
          "enum": [
            "valid",
            "invalid",
            "incomplete",
            "not_applicable"
          ]
        },
        "hygiene": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "coverage": {
          "enum": [
            "valid",
            "not-run"
          ]
        },
        "observatory": {
          "enum": [
            "normalized",
            "not-run"
          ]
        },
        "diagnostics_truncated": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roadmap",
        "decisions",
        "git",
        "issues",
        "pull_requests",
        "checks",
        "releases",
        "deployments",
        "history"
      ],
      "properties": {
        "roadmap": {
          "$ref": "#/$defs/claim"
        },
        "decisions": {
          "$ref": "#/$defs/claim"
        },
        "git": {
          "$ref": "#/$defs/claim"
        },
        "issues": {
          "$ref": "#/$defs/claim"
        },
        "pull_requests": {
          "$ref": "#/$defs/claim"
        },
        "checks": {
          "$ref": "#/$defs/claim"
        },
        "releases": {
          "$ref": "#/$defs/claim"
        },
        "deployments": {
          "$ref": "#/$defs/claim"
        },
        "history": {
          "$ref": "#/$defs/claim"
        }
      }
    },
    "candidate_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_sha256",
        "snapshot_sha256"
      ],
      "properties": {
        "projection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "schema": {
      "const": "egohygiene.relay.source-journey-build/v1"
    },
    "admission": {
      "const": "fresh-immutable-git"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "commit_revisions": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "freshness",
        "reason",
        "observed_at"
      ],
      "properties": {
        "collection": {
          "enum": [
            "uncollected",
            "unavailable",
            "partial",
            "observed_empty",
            "observed",
            "failed",
            "not_applicable"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
