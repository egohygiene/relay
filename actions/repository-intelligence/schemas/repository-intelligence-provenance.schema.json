      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "internal",
            "unknown"
          ]
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dashboard",
        "analytics",
        "repository_tree",
        "repository_report"
      ],
      "properties": {
        "dashboard": {
          "$ref": "#/$defs/contract"
        },
        "analytics": {
          "$ref": "#/$defs/contract"
        },
        "repository_tree": {
          "$ref": "#/$defs/contract"
        },
        "repository_report": {
          "$ref": "#/$defs/contract"
        }
