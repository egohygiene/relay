{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/repository-intelligence-provenance/v1/schema.json",
  "title": "Relay Repository Intelligence provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generator",
    "consumer",
    "contracts",
    "generated_at",
    "timestamp_source",
    "projection"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.relay.repository-intelligence-provenance/v1"
    },
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "repository",
        "source_ref",
        "source_commit",
        "immutable"
      ],
      "properties": {
        "name": {
          "const": "egohygiene/relay/actions/repository-intelligence"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "repository": {
          "const": "egohygiene/relay"
        },
        "source_ref": {
          "type": "string"
        },
        "source_commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "immutable": {
          "type": "boolean"
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "source_commit",
        "visibility"
