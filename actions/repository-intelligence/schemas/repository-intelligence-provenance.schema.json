        },
        "repository": {
          "type": "string",
          "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "domains": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "decisions": {
