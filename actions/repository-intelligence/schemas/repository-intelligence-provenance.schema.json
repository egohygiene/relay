{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/repository-intelligence-provenance/v1/schema.json",
  "title": "Relay Repository Intelligence provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "generator",
    "consumer",
    "contracts",
    "generated_at",
    "timestamp_source",
    "projection"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.relay.repository-intelligence-provenance/v1"
    },
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "repository",
        "source_ref",
        "source_commit",
        "immutable"
      ],
      "properties": {
        "name": {
          "const": "egohygiene/relay/actions/repository-intelligence"
        },
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "repository": {
          "const": "egohygiene/relay"
        },
        "source_ref": {
          "type": "string"
        },
        "source_commit": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "immutable": {
          "type": "boolean"
        }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_commit", "visibility"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "visibility": {
          "enum": ["public", "private", "internal", "unknown"]
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dashboard", "analytics", "repository_tree", "repository_report"],
      "properties": {
        "dashboard": {"$ref": "#/$defs/contract"},
        "analytics": {"$ref": "#/$defs/contract"},
        "repository_tree": {"$ref": "#/$defs/contract"},
        "repository_report": {"$ref": "#/$defs/contract"}
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timestamp_source": {
      "enum": ["consumer-source-commit", "explicit-input"]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "classification", "deployment_authority"],
      "properties": {
        "route": {
          "const": "/intelligence/"
        },
        "classification": {
          "enum": ["public-safe", "internal-only"]
        },
        "deployment_authority": {
          "const": "consumer"
        }
      }
    },
    "adr_collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lock_sha256",
            "egolint_sha256",
            "collector_sha256",
            "shared_runtime_sha256",
            "pins"
          ],
          "properties": {
            "lock_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "egolint_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "collector_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "shared_runtime_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "pins": {
              "type": "object"
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "egolint",
            "hygiene",
            "coverage",
            "observatory",
            "diagnostics_truncated"
          ],
          "properties": {
            "egolint": {
              "enum": [
                "valid",
                "invalid",
                "incomplete",
                "not_applicable"
              ]
            },
            "hygiene": {
              "enum": [
                "valid",
                "invalid"
              ]
            },
            "coverage": {
              "enum": [
                "valid",
                "not-run"
              ]
            },
            "observatory": {
              "enum": [
                "normalized",
                "not-run"
              ]
            },
            "diagnostics_truncated": {
              "type": "boolean"
            }
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roadmap",
            "decisions",
            "git",
            "issues",
            "pull_requests",
            "checks",
            "releases",
            "deployments",
            "history"
          ],
          "properties": {
            "roadmap": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "decisions": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "git": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "issues": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "pull_requests": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "checks": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "releases": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "deployments": {
              "$ref": "#/$defs/adrCollectionClaim"
            },
            "history": {
              "$ref": "#/$defs/adrCollectionClaim"
            }
          }
        },
        "candidate_digests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection_sha256",
            "snapshot_sha256"
          ],
          "properties": {
            "projection_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "snapshot_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "adoption": {
          "const": "present"
        },
        "policy_reference": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "decision_directory": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "index": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "maximum_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2678400
        },
        "sources": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 240,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "schema": {
          "const": "egohygiene.relay.adr-build/v1"
        }
      },
      "required": [
        "repository",
        "observed_at",
        "runtime",
        "validation",
        "coverage",
        "candidate_digests",
        "source_commit",
        "adoption",
        "policy_reference",
        "decision_directory",
        "index",
        "collected_at",
        "maximum_age_seconds",
        "sources",
        "schema"
      ]
    }
  },
  "$defs": {
    "adrCollectionClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "freshness",
        "reason",
        "observed_at"
      ],
      "properties": {
        "collection": {
          "enum": [
            "uncollected",
            "unavailable",
            "partial",
            "observed_empty",
            "observed",
            "failed",
            "not_applicable"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string"
        },
        "observed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version"],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
