{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/repository-intelligence-build-manifest/v1/schema.json",
  "title": "Relay Repository Intelligence build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "consumer",
    "generator",
    "contracts",
    "source_epoch",
    "enabled_routes",
    "bundle"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.relay.repository-intelligence-build-manifest/v1"
    },
    "schema_version": {"const": 1},
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "version"],
      "properties": {
        "repository": {"const": "egohygiene/relay"},
        "revision": {"$ref": "#/$defs/revision"},
        "version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_inputs",
        "analytics",
        "build_manifest",
        "dashboard",
        "observatory_comparison",
        "observatory_snapshot",
        "provenance",
        "repository_report",
        "repository_tree"
      ],
      "properties": {
        "action_inputs": {"$ref": "#/$defs/contract"},
        "analytics": {"$ref": "#/$defs/contract"},
        "build_manifest": {"$ref": "#/$defs/contract"},
        "dashboard": {"$ref": "#/$defs/contract"},
        "observatory_comparison": {"$ref": "#/$defs/contract"},
        "observatory_snapshot": {"$ref": "#/$defs/contract"},
        "provenance": {"$ref": "#/$defs/contract"},
        "repository_report": {"$ref": "#/$defs/contract"},
        "repository_tree": {"$ref": "#/$defs/contract"}
      }
    },
    "source_epoch": {"type": "integer", "minimum": 0},
    "enabled_routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^/intelligence/(?:[a-z0-9-]+/)?$"
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "file_count", "files", "total_bytes"],
      "properties": {
        "algorithm": {"const": "sha256-canonical-file-inventory-v1"},
        "digest": {"$ref": "#/$defs/digest"},
        "file_count": {"type": "integer", "minimum": 1},
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/file"}
        },
        "total_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version"],
      "properties": {
        "schema": {"type": "string", "minLength": 1},
        "version": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "minLength": 1}
          ]
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
