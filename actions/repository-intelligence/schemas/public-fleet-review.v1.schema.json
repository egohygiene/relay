{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "publication",
    "status",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.relay.public-fleet-review/v1"
    },
    "publication": {
      "const": "denied"
    },
    "status": {
      "enum": [
        "ready",
        "partial",
        "unavailable",
        "denied"
      ]
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "owner",
          "remediation"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z_]+$"
          },
          "owner": {
            "enum": [
              "relay",
              "hygiene",
              "observatory"
            ]
          },
          "remediation": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "inputs": {
      "type": "object"
    },
    "runtime": {
      "type": "object"
    },
    "repositories": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object"
      }
    },
    "fleet_snapshot_candidate": {
      "type": [
        "object",
        "null"
      ]
    },
    "candidate_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/public-fleet-review.v1.schema.json",
  "title": "Public-only fleet artifact assembly review; publication denied",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "denied"
          }
        }
      },
      "then": {
        "maxProperties": 4
      },
      "else": {
        "required": [
          "schema",
          "publication",
          "status",
          "diagnostics",
          "observed_at",
          "inputs",
          "runtime",
          "repositories",
          "fleet_snapshot_candidate",
          "candidate_sha256"
        ]
      }
    }
  ]
}
