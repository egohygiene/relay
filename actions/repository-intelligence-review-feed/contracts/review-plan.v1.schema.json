{
  "$id": "https://egohygiene.github.io/relay/schemas/typed-review-plan.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "audits": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 240,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "contract_version": {
      "const": "1.0.0-alpha.1"
    },
    "repository": {
      "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$",
      "type": "string"
    },
    "sanity": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "maxLength": 240,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "egohygiene.relay.typed-review-plan/v1"
    },
    "visibility": {
      "const": "public"
    }
  },
  "required": [
    "schema",
    "contract_version",
    "visibility",
    "repository",
    "audits",
    "sanity"
  ],
  "title": "Explicit Git-only public typed review plan",
  "type": "object"
}
