{
  "$schema": "./schemas/action-catalog.schema.json",
  "schema": "egohygiene.relay-action-catalog/v1",
  "schema_version": 1,
  "release_model": {
    "unit": "repository",
    "immutable": "vMAJOR.MINOR.PATCH",
    "moving_alias": "vMAJOR",
    "recommended_consumer_pin": "full-commit-sha"
  },
  "actions": [
    {
      "id": "normalize-repository-report",
      "path": "actions/normalize-repository-report",
      "name": "Normalize Repository Report",
      "summary": "Normalize OSV, MegaLinter, and Scorecard output into one public report contract.",
      "status": "beta",
      "runtime": ["bash", "python3"],
      "permissions": {},
      "side_effects": ["workspace-write"],
      "consumer_ref": "egohygiene/relay/actions/normalize-repository-report@v1"
    },
    {
      "id": "publish-report-snapshot",
      "path": "actions/publish-report-snapshot",
      "name": "Publish Report Snapshot",
      "summary": "Publish guarded, stable .reports snapshots from trusted default-branch jobs.",
      "status": "beta",
      "runtime": ["bash", "git"],
      "permissions": {"contents": "write"},
      "side_effects": ["git-commit", "git-push", "repository-write"],
      "consumer_ref": "egohygiene/relay/actions/publish-report-snapshot@v1"
    },
    {
      "id": "repository-intelligence",
      "path": "actions/repository-intelligence",
      "name": "Repository Intelligence",
      "summary": "Build a deterministic routed intelligence site with operational, roadmap, ADR decision-ledger, and semantic Git journey views.",
      "status": "beta",
      "runtime": ["bash", "git", "python3"],
      "permissions": {"contents": "read"},
      "side_effects": ["workspace-write"],
      "consumer_ref": "egohygiene/relay/actions/repository-intelligence@v1"
    },
    {
      "id": "validate-publication-site",
      "path": "actions/validate-publication-site",
      "name": "Validate Publication Site",
      "summary": "Validate caller-built publication hub routes, lifecycle claims, files, and complete checksums without rendering or deploying.",
      "status": "beta",
      "runtime": [
        "bash",
        "python3"
      ],
      "permissions": {},
      "side_effects": [
        "workspace-write"
      ],
      "consumer_ref": "egohygiene/relay/actions/validate-publication-site@v1"
    },
    {
      "id": "verify-publication-pages",
      "path": "actions/verify-publication-pages",
      "name": "Verify Publication Pages",
      "summary": "Verify deployed HTTPS publication routes and every checksummed byte with bounded retries and deterministic evidence.",
      "status": "beta",
      "runtime": [
        "bash",
        "python3"
      ],
      "permissions": {},
      "side_effects": [
        "network-read",
        "workspace-write"
      ],
      "consumer_ref": "egohygiene/relay/actions/verify-publication-pages@v1"
    }
  ],
  "workflows": [
    {
      "id": "publication-pages",
      "path": ".github/workflows/publication-pages.yml",
      "name": "Publication Pages Lifecycle",
      "summary": "Review caller-built publication bytes, conditionally deploy the exact reviewed tree, and verify public HTTPS routes.",
      "status": "beta",
      "permissions": {
        "actions": "read",
        "contents": "read",
        "id-token": "write",
        "pages": "write"
      },
      "consumer_ref": "egohygiene/relay/.github/workflows/publication-pages.yml@v1"
    },
    {
      "id": "repository-intelligence",
      "path": ".github/workflows/repository-intelligence.yml",
      "name": "Repository Intelligence Artifact",
      "summary": "Build and upload a routed repository intelligence site as a workflow artifact.",
      "status": "beta",
      "permissions": {"contents": "read"},
      "consumer_ref": "egohygiene/relay/.github/workflows/repository-intelligence.yml@v1"
    }
  ]
}
