        "trust_class": "untrusted-content",
        "authority": "contents-read-artifact-only"
      }
    },
    {
      "id": "manual-rebuild",
      "changes": {
        "repository": "egohygiene/Relay",
        "represented_revision": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "event_name": "workflow_dispatch",
        "caller_workflow_ref": "egohygiene/relay/.github/workflows/repository-intelligence.yml@bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expected": {
        "event_class": "manual-rebuild",
        "invocation_class": "direct-dispatch",
        "trust_class": "untrusted-content",
        "authority": "contents-read-artifact-only"
      }
    }
  ],
