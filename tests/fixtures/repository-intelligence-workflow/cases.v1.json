  "event_cases": [
    {
      "id": "trusted-pull-request",
      "changes": {
        "event_name": "pull_request",
        "ref": "refs/pull/104/merge",
        "pull_request_head_repository": "example/repository"
      },
      "expected": {
        "event_class": "trusted-pull-request",
        "invocation_class": "reusable-call",
        "trust_class": "untrusted-content",
        "authority": "contents-read-artifact-only"
      }
    },
    {
      "id": "fork-pull-request",
      "changes": {
        "event_name": "pull_request",
        "ref": "refs/pull/105/merge",
        "pull_request_head_repository": "external/fork"
      },
      "expected": {
        "event_class": "fork-pull-request",
        "invocation_class": "reusable-call",
        "trust_class": "untrusted-content",
        "authority": "contents-read-artifact-only"
      }
    },
    {
      "id": "default-branch-push",
      "changes": {
        "event_name": "push",
        "ref": "refs/heads/main"
      },
      "expected": {
        "event_class": "default-branch-push",
        "invocation_class": "reusable-call",
        "trust_class": "trusted-default-branch",
        "authority": "contents-read-artifact-only"
      }
    },
    {
      "id": "reusable-call",
      "changes": {
        "event_name": "workflow_dispatch",
