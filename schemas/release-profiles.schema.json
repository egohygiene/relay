{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/release-profiles/v1/schema.json",
  "title": "Relay artifact release profiles v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "schema_version", "profiles"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "egohygiene.relay-release-profiles/v1"},
    "schema_version": {"const": 1},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository_classes",
        "delivery",
        "required_paths",
        "required_globs",
        "required_any_globs",
        "rollback"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "uniqueItems": true
        },
        "delivery": {"enum": ["github-release", "github-release-evidence"]},
        "required_paths": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
          "uniqueItems": true
        },
        "required_globs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "required_any_globs": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "instructions"],
          "properties": {
            "strategy": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
            "instructions": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
