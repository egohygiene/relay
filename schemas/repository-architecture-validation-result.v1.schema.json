{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/repository-architecture-validation-result/v1/schema.json",
  "title": "Relay repository architecture validation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "repository", "mode", "semantic_status", "outcome", "coverage", "provenance", "findings", "counts", "bounds", "artifacts", "privacy"],
  "properties": {
    "schema_version": {"const": "relay.repository-architecture-validation-result/v1"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "visibility", "represented_revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "visibility": {"enum": ["public", "private", "internal"]},
        "represented_revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|working-tree|unknown|not-applicable)$"}
      }
    },
    "mode": {"enum": ["advisory", "required"]},
    "semantic_status": {"enum": ["conformant", "nonconformant", "legacy", "incomplete", "not-applicable", "unavailable"]},
    "outcome": {"enum": ["passed", "warning", "failed", "unavailable"]},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository-contracts", "architecture-records", "diagram-sources"],
      "properties": {
        "repository-contracts": {"$ref": "#/$defs/coverage"},
        "architecture-records": {"$ref": "#/$defs/coverage"},
        "diagram-sources": {"$ref": "#/$defs/coverage"}
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "revision", "profile_source_id"],
        "properties": {
          "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "profile_source_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/finding"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info", "warning", "error", "critical", "total"],
      "properties": {
        "info": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "critical": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_findings", "observed_findings", "findings_truncated", "maximum_scanned_files", "observed_scanned_files", "maximum_scanned_bytes", "observed_scanned_bytes", "scan_truncated"],
      "properties": {
        "maximum_findings": {"type": "integer", "minimum": 1, "maximum": 256},
        "observed_findings": {"type": "integer", "minimum": 0},
        "findings_truncated": {"type": "boolean"},
        "maximum_scanned_files": {"type": "integer", "minimum": 1, "maximum": 10000},
        "observed_scanned_files": {"type": "integer", "minimum": 0},
        "maximum_scanned_bytes": {"type": "integer", "minimum": 1, "maximum": 104857600},
        "observed_scanned_bytes": {"type": "integer", "minimum": 0},
        "scan_truncated": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["egolint_run", "egolint_sarif", "repository_intelligence", "diagram_evidence"],
      "properties": {
        "egolint_run": {"$ref": "#/$defs/nullablePath"},
        "egolint_sarif": {"$ref": "#/$defs/nullablePath"},
        "repository_intelligence": {"$ref": "#/$defs/nullablePath"},
        "diagram_evidence": {"$ref": "#/$defs/nullablePath"}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "contains_source_content", "path_policy", "redaction"],
      "properties": {
        "classification": {"enum": ["public-repository", "private-repository", "internal-repository"]},
        "contains_source_content": {"const": false},
        "path_policy": {"const": "repository-relative-only"},
        "redaction": {"const": "bounded-diagnostics-only"}
      }
    }
  },
  "$defs": {
    "coverage": {"enum": ["passed", "failed", "partial", "unavailable", "not-applicable"]},
    "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9._/@-]+$"},
    "nullablePath": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "source", "path", "line", "summary", "remediation"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+-[0-9]{3}$"},
        "severity": {"enum": ["info", "warning", "error", "critical"]},
        "source": {"enum": ["egolint", "diagram-validator", "relay"]},
        "path": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/path"}]},
        "line": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 512},
        "remediation": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"semantic_status": {"const": "conformant"}}},
      "then": {"properties": {"outcome": {"const": "passed"}}}
    },
    {
      "if": {"properties": {"semantic_status": {"const": "unavailable"}}},
      "then": {"properties": {"outcome": {"const": "unavailable"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "advisory"}, "semantic_status": {"enum": ["nonconformant", "legacy", "incomplete"]}}, "required": ["mode", "semantic_status"]},
      "then": {"properties": {"outcome": {"const": "warning"}}}
    },
    {
      "if": {"properties": {"mode": {"const": "required"}, "semantic_status": {"enum": ["nonconformant", "legacy", "incomplete"]}}, "required": ["mode", "semantic_status"]},
      "then": {"properties": {"outcome": {"const": "failed"}}}
    },
    {
      "if": {"properties": {"repository": {"properties": {"visibility": {"const": "private"}}}}},
      "then": {"properties": {"privacy": {"properties": {"classification": {"const": "private-repository"}}}}}
    }
  ]
}
