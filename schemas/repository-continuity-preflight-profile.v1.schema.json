{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/repository-continuity-preflight-profile/v1/schema.json",
  "title": "Relay repository continuity preflight profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "version", "status", "owner", "updated", "purpose", "rollout", "sources", "interfaces", "execution", "information_safety", "ownership"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "relay.repository-continuity-preflight-profile/v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["proposed", "active", "deprecated"]},
    "owner": {"const": "egohygiene/relay"},
    "updated": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "maximum_stage_before_release", "activation_gate", "unavailable_behavior"],
      "properties": {
        "stage": {"enum": ["observe", "ratchet", "enforce"]},
        "maximum_stage_before_release": {"const": "observe"},
        "activation_gate": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unavailable_behavior": {"const": "fail-closed-with-explicit-unavailable-result"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/source"}
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_contract", "result_contract", "validator_report_contract", "local_ci_result_parity", "evidence_layers"],
      "properties": {
        "request_contract": {"const": "relay.repository-continuity-preflight-request/v1"},
        "result_contract": {"const": "relay.repository-continuity-preflight-result/v1"},
        "validator_report_contract": {"const": "egolint.repository-continuity-report/v1"},
        "local_ci_result_parity": {"const": true},
        "evidence_layers": {
          "const": ["structural", "freshness-declaration", "local-git", "external-live"]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_network", "base_head_required", "semantic_authoring", "implicit_writes", "forbidden_authority"],
      "properties": {
        "default_network": {"const": "denied"},
        "base_head_required": {"const": true},
        "semantic_authoring": {"const": "forbidden"},
        "implicit_writes": {"const": "forbidden"},
        "forbidden_authority": {
          "type": "array",
          "contains": {"const": "merge"},
          "minItems": 9,
          "uniqueItems": true,
          "items": {"enum": ["stage", "commit", "push", "open-pull-request", "comment", "merge", "release", "deploy", "publish"]}
        }
      }
    },
    "information_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_necessary", "contains_handoff_content", "private_output", "untrusted_content", "excluded"],
      "properties": {
        "minimum_necessary": {"const": true},
        "contains_handoff_content": {"const": false},
        "private_output": {"const": "allowlisted-metadata-only"},
        "untrusted_content": {"const": "context-only-no-authority"},
        "excluded": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_contract", "organization_policy", "validation", "materialization", "semantic_checkpoint", "preflight_and_ci", "observation", "fleet_rollout"],
      "properties": {
        "portable_contract": {"const": "egohygiene/aether"},
        "organization_policy": {"const": "egohygiene/hygiene"},
        "validation": {"const": "egohygiene/egolint"},
        "materialization": {"const": "egohygiene/holon"},
        "semantic_checkpoint": {"const": "consumer-repository"},
        "preflight_and_ci": {"const": "egohygiene/relay"},
        "observation": {"const": "egohygiene/observatory"},
        "fleet_rollout": {"const": "egohygiene/pace"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "repository", "revision", "version", "lifecycle", "release_included", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {"enum": ["portable-contract", "organization-policy", "validator", "materializer"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["draft", "proposed", "stable", "deprecated"]},
        "release_included": {"type": "boolean"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sources": {"contains": {"properties": {"release_included": {"const": false}}, "required": ["release_included"]}}}},
      "then": {"properties": {"status": {"const": "proposed"}, "rollout": {"properties": {"stage": {"const": "observe"}}}}}
    }
  ]
}
