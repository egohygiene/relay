{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/issue-title-reviews.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "repository",
    "snapshot_sha256",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.relay.issue-title-reviews/v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "type",
          "subject"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "subject": {
            "type": "string",
            "maxLength": 1024
          }
        }
      },
      "maxItems": 2000
    }
  }
}
