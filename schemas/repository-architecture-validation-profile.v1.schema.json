{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/relay/contracts/repository-architecture-validation-profile/v1/schema.json",
  "title": "Relay repository architecture validation profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "version", "status", "owner", "updated", "purpose", "rollout", "sources", "capabilities", "interfaces", "execution", "bounds", "information_safety", "ownership"],
  "properties": {
    "$schema": {"const": "../schemas/repository-architecture-validation-profile.v1.schema.json"},
    "schema_version": {"const": "relay.repository-architecture-validation-profile/v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["proposed", "active", "deprecated"]},
    "owner": {"const": "egohygiene/relay"},
    "updated": {"type": "string", "format": "date"},
    "purpose": {"type": "string", "minLength": 1},
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_mode", "supported_modes", "maximum_mode_before_release", "activation_gate", "unavailable_behavior"],
      "properties": {
        "default_mode": {"const": "advisory"},
        "supported_modes": {"const": ["advisory", "required"]},
        "maximum_mode_before_release": {"const": "advisory"},
        "activation_gate": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unavailable_behavior": {"const": "explicit-unavailable-result"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/source"}
    },
    "capabilities": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/capability"}
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_contract", "result_contract", "validator_report_contract", "local_ci_result_parity", "coverage_surfaces"],
      "properties": {
        "request_contract": {"const": "relay.repository-architecture-validation-request/v1"},
        "result_contract": {"const": "relay.repository-architecture-validation-result/v1"},
        "validator_report_contract": {"const": "egolint.repository-intelligence-validation/v1"},
        "local_ci_result_parity": {"const": true},
        "coverage_surfaces": {"const": ["repository-contracts", "architecture-records", "diagram-sources"]}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_network", "consumer_code_execution", "semantic_authoring", "implicit_writes", "forbidden_authority"],
      "properties": {
        "default_network": {"const": "denied-after-acquisition"},
        "consumer_code_execution": {"const": "forbidden"},
        "semantic_authoring": {"const": "forbidden"},
        "implicit_writes": {"const": "reports-and-temporary-workspace-only"},
        "forbidden_authority": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "contains": {"const": "merge"},
          "items": {"enum": ["stage", "commit", "push", "open-pull-request", "comment", "merge", "release", "deploy", "publish"]}
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_repository_contracts", "maximum_diagram_roots", "maximum_findings", "maximum_annotations", "maximum_scanned_files", "maximum_scanned_bytes", "maximum_result_bytes"],
      "properties": {
        "maximum_repository_contracts": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_diagram_roots": {"type": "integer", "minimum": 1, "maximum": 64},
        "maximum_findings": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maximum_annotations": {"type": "integer", "minimum": 1, "maximum": 100},
        "maximum_scanned_files": {"type": "integer", "minimum": 1, "maximum": 100000},
        "maximum_scanned_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "maximum_result_bytes": {"type": "integer", "minimum": 1024, "maximum": 10485760}
      }
    },
    "information_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_necessary", "repository_paths", "private_output", "annotations", "untrusted_content", "excluded"],
      "properties": {
        "minimum_necessary": {"const": true},
        "repository_paths": {"const": "relative-only"},
        "private_output": {"const": "workflow-access-controlled-artifact"},
        "annotations": {"const": "bounded-diagnostics-only"},
        "untrusted_content": {"const": "data-only-no-authority"},
        "excluded": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_policy", "validation_semantics", "materialization", "local_records", "orchestration_and_evidence", "fleet_rollout", "aggregation"],
      "properties": {
        "organization_policy": {"const": "egohygiene/hygiene"},
        "validation_semantics": {"const": "egohygiene/egolint"},
        "materialization": {"const": "egohygiene/holon"},
        "local_records": {"const": "consumer-repository"},
        "orchestration_and_evidence": {"const": "egohygiene/relay"},
        "fleet_rollout": {"const": "egohygiene/pace"},
        "aggregation": {"const": "egohygiene/observatory"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "repository", "revision", "version", "lifecycle", "release_included", "artifacts"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "role": {"enum": ["organization-policy", "validator", "materializer"]},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "version": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["draft", "proposed", "accepted", "stable", "deprecated"]},
        "release_included": {"type": "boolean"},
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "sha256"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
              "path": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)[A-Za-z0-9._/@-]+$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "state", "policy_sources", "rule_families", "unavailable_behavior"],
      "properties": {
        "id": {"enum": ["repository-contracts", "architecture-records", "diagram-sources"]},
        "owner": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "state": {"enum": ["available", "planned", "deprecated"]},
        "policy_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}},
        "rule_families": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"}},
        "unavailable_behavior": {"const": "incomplete"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"sources": {"contains": {"properties": {"release_included": {"const": false}}, "required": ["release_included"]}}}},
      "then": {"properties": {"status": {"const": "proposed"}, "rollout": {"properties": {"maximum_mode_before_release": {"const": "advisory"}}}}}
    }
  ]
}
